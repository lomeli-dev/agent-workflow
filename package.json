{
  "name": "@lomeli-dev/agent-workflow",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Portable agent workflows with Rulesync generation, reversible global installation and project opt-out",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "agent-workflow": "bin/agent-workflow.mjs"
  },
  "files": [
