{
  "name": "@lomeli-dev/agent-workflow",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Portable agent workflows with Rulesync generation, reversible global installation and project opt-out",
  "license": "MIT",
  "homepage": "https://lomeli-dev.github.io/agent-workflow/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lomeli-dev/agent-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/lomeli-dev/agent-workflow/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "agent-workflow": "bin/agent-workflow.mjs"
  },
  "files": [
    "bin",
    "lib",
    ".rulesync",
    "generated",
    "docs",
    "!docs/prompts",
    "README.md",
    "README.es.md",
    "rulesync.jsonc",
    "CHANGELOG.md",
    "examples/native-client-lab"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "site": "node scripts/site.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && node scripts/check.mjs"
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "jsonc-parser": "3.3.1",
    "rulesync": "43.8.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
